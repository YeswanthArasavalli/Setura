# SETURA staff console — local environment template.
# Copy to .env.local for local development. NEVER put service-role or any
# secret key here: the browser only ever receives the PUBLIC anon key
# (Phase 6 §21). Real authorization is enforced server-side by RLS + Edge
# Functions, never by this file.

# Local Supabase stack (supabase start) API gateway URL.
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Public anon key ONLY. The value below is the well-known deterministic
# local-development demo key produced by the Supabase CLI; it is not a
# secret and is safe to commit as an example. Replace per environment.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
