      "id": "file:supabase/functions/_shared/audit.ts",
      "type": "file",
      "name": "audit.ts",
      "filePath": "supabase/functions/_shared/audit.ts",
      "summary": "Provides fire-and-forget audit event writing to the audit_logs table via write_audit_log RPC. Enforces that governance events never silently disappear by coercing non-UUID entity/actor references into data fields, reading PostgREST errors explicitly, and reporting failures to logger and metrics.",
      "tags": ["utility", "audit", "logging", "shared"],
      "complexity": "moderate",
      "languageNotes": "Exports AuditEvent, AuditWriteOutcome, AuditActionType, and severity types used across all Edge Functions."
    },
    {
      "id": "function:supabase/functions/_shared/audit.ts:logAuditEvent",
      "type": "function",
      "name": "logAuditEvent",
      "filePath": "supabase/functions/_shared/audit.ts",
      "lineRange": [121, 212],
      "summary": "Writes a structured audit event to audit_logs via write_audit_log RPC. Never throws; returns AuditWriteOutcome so callers can react to failures. Relocates non-UUID entityId/actorUserId into newData.entityRef/newData.actorRef to preserve the reference while satisfying UUID column constraints.",
      "tags": ["utility", "audit", "logging", "rpc"],
      "complexity": "moderate"
    },
    {
      "id": "function:supabase/functions/_shared/audit.ts:isUuid",
      "type": "function",
      "name": "isUuid",
      "filePath": "supabase/functions/_shared/audit.ts",
      "lineRange": [107, 109],
      "summary": "Returns true when a string matches the 8-4-4-4-12 hex UUID pattern accepted by PostgreSQL uuid input.",
      "tags": ["utility", "validation"],
      "complexity": "simple"
    },
    {
      "id": "file:supabase/functions/_shared/whatsapp/whatsapp_booking_flow.ts",
      "type": "file",
      "name": "whatsapp_booking_flow.ts",
      "filePath": "supabase/functions/_shared/whatsapp/whatsapp_booking_flow.ts",
      "summary": "WhatsApp booking flow: patient identified, doctor selected, date validated, booking confirmed. State machine with steps: name, doctor, date, confirm. Delegates booking creation to the atomic create_booking RPC to avoid duplicating allocation, fee lookup, and availability logic.",
      "tags": ["service", "whatsapp", "booking", "conversation-flow"],
      "complexity": "complex",
      "languageNotes": "Stateful flow using BookingFlowState with step-based progression. Reuses is_doctor_available RPC, get_effective_fees RPC, hospital holiday/working-hours checks, and the canonical create_booking RPC."
    },
    {
      "id": "function:supabase/functions/_shared/whatsapp/whatsapp_booking_flow.ts:startBookingFlow",
      "type": "function",
      "name": "startBookingFlow",
      "filePath": "supabase/functions/_shared/whatsapp/whatsapp_booking_flow.ts",
      "lineRange": [429, 454],
      "summary": "Entry point when a booking intent arrives outside an active flow. Captures date hints from the initial message, resolves or creates the patient, and begins the doctor-selection step.",
      "tags": ["whatsapp", "booking", "conversation-flow"],
      "complexity": "simple"
    },
    {
      "id": "function:supabase/functions/_shared/whatsapp/whatsapp_booking_flow.ts:continueBookingFlow",
      "type": "function",
      "name": "continueBookingFlow",
      "filePath": "supabase/functions/_shared/whatsapp/whatsapp_booking_flow.ts",
      "lineRange": [457, 576],
      "summary": "Advances an in-progress booking flow based on the current state (booking, selecting_doctor, selecting_date, confirming). Handles retries up to MAX_STEP_RETRIES (3) before escalating to human handoff. Executes booking via create_booking RPC with idempotency key.",
      "tags": ["whatsapp", "booking", "conversation-flow", "state-machine"],
      "complexity": "complex"
    },
