{
  "nodes": [
    {
      "id": "document:.qoder/repowiki/en/content/Architecture Overview/Architecture Overview.md",
      "type": "document",
      "name": "Architecture Overview.md",
      "filePath": ".qoder/repowiki/en/content/Architecture Overview/Architecture Overview.md",
      "summary": "Entry-point documentation for Setura Hospital OS architecture covering Supabase Edge Functions, PostgreSQL backend, multi-tenant isolation, RBAC, idempotent APIs, background workers, and external integrations with Meta WhatsApp and Razorpay.",
      "tags": ["qoder-wiki", "architecture", "documentation", "entry-point", "supabase"],
      "complexity": "complex"
    },
    {
      "id": "document:.qoder/repowiki/en/content/Architecture Overview/Core Architecture Patterns.md",
      "type": "document",
      "name": "Core Architecture Patterns.md",
      "filePath": ".qoder/repowiki/en/content/Architecture Overview/Core Architecture Patterns.md",
      "summary": "Documents core architectural patterns including serverless edge functions per business operation, microservices-style isolation, event-driven processing via job queues, repository-like database abstractions, and middleware composition for cross-cutting concerns.",
      "tags": ["qoder-wiki", "architecture-patterns", "documentation", "edge-functions", "event-driven"],
      "complexity": "complex"
    },
    {
      "id": "document:.qoder/repowiki/en/content/Architecture Overview/Database Design Principles.md",
      "type": "document",
      "name": "Database Design Principles.md",
      "filePath": ".qoder/repowiki/en/content/Architecture Overview/Database Design Principles.md",
      "summary": "Explains multi-client database architecture with service-role, anonymous, and auth-scoped clients; progressive migration strategy; typed client generation; and multi-tenant isolation at data and query levels with indexing and connection pooling strategies.",
      "tags": ["qoder-wiki", "database-design", "documentation", "multi-tenancy", "migrations"],
      "complexity": "complex"
    },
    {
      "id": "document:.qoder/repowiki/en/content/Architecture Overview/Integration Patterns.md",
      "type": "document",
      "name": "Integration Patterns.md",
      "filePath": ".qoder/repowiki/en/content/Architecture Overview/Integration Patterns.md",
      "summary": "Documents external service integration patterns for WhatsApp Business API webhooks, Meta Cloud API outbound messaging, Razorpay payment order creation/verification, webhook security with HMAC verification, and database-backed message queue for asynchronous processing.",
      "tags": ["qoder-wiki", "integration-patterns", "documentation", "webhooks", "external-apis"],
      "complexity": "complex"
    },
    {
      "id": "document:.qoder/repowiki/en/content/Architecture Overview/Security Model.md",
      "type": "document",
      "name": "Security Model.md",
      "filePath": ".qoder/repowiki/en/content/Architecture Overview/Security Model.md",
      "summary": "Documents the security model covering JWT-based authentication, multi-tenant hospital isolation via RBAC, granular permissions for patients/doctors/receptionists/admins, abuse protection with rate limiting, and comprehensive audit logging for compliance.",
      "tags": ["qoder-wiki", "security-model", "documentation", "authentication", "authorization"],
      "complexity": "complex"
    },
    {
      "id": "document:.qoder/repowiki/en/content/Architecture Overview/Shared Utilities Layer.md",
      "type": "document",
      "name": "Shared Utilities Layer.md",
      "filePath": ".qoder/repowiki/en/content/Architecture Overview/Shared Utilities Layer.md",
      "summary": "Documents the shared utilities layer powering all edge functions: JWT authentication middleware with hospital isolation, Zod-based validation, centralized error handling, structured logging with correlation IDs, metrics collection, tracing, and CORS support.",
      "tags": ["qoder-wiki", "shared-utilities", "documentation", "middleware", "validation"],
      "complexity": "complex"
    }
  ],
