SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
APP_ENV=production
LOG_LEVEL=info
DEPLOYMENT_VERSION=v1.0.0
META_ACCESS_TOKEN=EAA...
META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=your_random_32char_secret
META_PHONE_NUMBER_ID=123456789012345
META_API_VERSION=v19.0
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your_razorpay_secret
CRON_SECRET=your_cron_shared_secret
WORKER_SECRET=your_worker_shared_secret
# Decision D6 (RESOLVED: true + secret discipline). The shipped deployment
# template enables the worker wake in run-cron-minute. This value alone is NOT
# sufficient for autonomous processing: the operator must also (1) provision a
# genuine CRON_SECRET, (2) provision the worker authentication secret(s) the
# implementation requires (WORKER_SECRET for worker-dispatched sends), (3) arm
# the scheduler (migration 53 pg_cron schedules / scheduler_http_config base
# URL), and (4) verify the wake path end to end. With CRON_SECRET absent or
# mismatched, run-background-worker still fails closed with 403 and the minute
# tick records errors.worker; enabling the trigger never widens authorization.
# Matching is exact: only the literal string "true" enables the wake. Values
# such as True, TRUE, 1, or whitespace-padded variants are treated as DISABLED.
# false remains valid where the worker is scheduled externally instead.
ENABLE_WORKER_TRIGGER=true
ALLOWED_ORIGINS=https://setura.in,https://app.setura.in
MAX_BOOKING_ADVANCE_DAYS=7
RATE_LIMIT_WINDOW_MINUTES=10
RATE_LIMIT_MAX_ATTEMPTS=5
WORKER_LEASE_SECS=30
