{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true
  },
  "imports": {
    "zod": "https://deno.land/x/zod@v3.22.4/mod.ts",
    "@supabase/supabase-js": "https://esm.sh/@supabase/supabase-js@2.39.7"
  },
  "tasks": {
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno check scripts/*.ts tests/unit/*.ts tests/integration/*.ts tests/utils/*.ts supabase/functions/*/index.ts",
    "test": "deno test --allow-env --allow-read tests/unit/",
    "test:integration": "deno test --allow-net --allow-env --allow-run tests/integration/",
    "validate:migrations": "deno run --allow-read scripts/validate_migrations.ts",
    "gen:types": "deno run --allow-run=supabase --allow-read --allow-write scripts/gen_types.ts",
    "gen:types:check": "deno run --allow-run=supabase --allow-read scripts/gen_types.ts --check",
    "db:reset": "supabase db reset"
  },
  "fmt": {
    "exclude": [
      "supabase/functions/_shared/database.generated.ts",
      "supabase/.temp/",
      "supabase/.branches/"
    ]
  },
  "lint": {
    "exclude": [
      "supabase/functions/_shared/database.generated.ts",
      "supabase/.temp/",
      "supabase/.branches/"
    ],
    "rules": {
      "exclude": ["no-import-prefix"]
    }
  }
}
